{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "karma-conduit",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "entry": "splash.html"
      },
      "game": {
        "entry": "game.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "menu": {
    "items": [
      {
        "label": "Post Today's Karma Conduit",
        "description": "Publish today's daily Karma Conduit puzzle to this subreddit",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-create"
      },
      {
        "label": "Create Custom Conduit Challenge",
        "description": "Configure a custom seeded Karma Conduit puzzle post",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/custom-challenge"
      }
    ]
  },
  "forms": {
    "challengeForm": "/internal/form/challenge-submit"
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  },
  "dev": {
    "subreddit": "karma_conduit_dev"
  }
}